# Copy to .env and edit. Every setting is optional; the defaults run locally.

# ---- AI (needed only for AI outputs; file conversions work without it) ----
# anthropic | openai | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# writes the final output
ANTHROPIC_MODEL=claude-sonnet-5-5
# reads long pages chunk by chunk
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
# any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# Google AI Studio key (https://aistudio.google.com/apikey); set AI_PROVIDER=gemini to use it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=120
# ~6k tokens per chunk
AI_CHUNK_CHARS=24000
# hard budget per output
AI_MAX_TOTAL_CHARS=400000

# ---- Storage ----
# Local default: SQLite at data/app.db and files under data/files.
# Production (required on Vercel): a hosted PostgreSQL URL. postgres:// and postgresql://
# are accepted as-is; on serverless use the provider's *pooled* connection string.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# local = files on disk (STORAGE_DIR); database = files stored in the database (Vercel default)
# STORAGE_BACKEND=local
# STORAGE_DIR=data/files
# Largest generated file that will be stored, in bytes (default 25 MB)
# MAX_STORED_FILE_BYTES=26214400

# ---- Serverless / Vercel (detected automatically from VERCEL=1) ----
# Scratch directory for runtime files (default: data/ locally, /tmp/distill on Vercel)
# RUNTIME_DIR=/tmp/distill
# inline = finish jobs inside the request (Vercel default); background = after the response
# JOB_MODE=background
# Jobs still "running" after this many minutes are marked interrupted (Vercel default 6)
# STALE_JOB_MINUTES=30
# Throwaway demo on Vercel without a database (data can vanish at any time)
# ALLOW_EPHEMERAL_STORAGE=1
# Treat any other read-only/short-lived platform like Vercel
# SERVERLESS=1

# ---- Fetching ----
USER_AGENT=Mozilla/5.0 (compatible; Distill/2.0)
REQUEST_TIMEOUT=20
MAX_PAGE_BYTES=8388608
MAX_REDIRECTS=5
# use headless Chromium for JavaScript-heavy pages (default: on locally, off on Vercel)
# JS_RENDERING=true
# TAKE_SCREENSHOTS=true
# use an installed Google Chrome instead of Playwright's Chromium
# BROWSER_CHANNEL=chrome

# ---- Limits & protection ----
# defaults: 100 / 5 locally, 20 / 3 on Vercel (requests must finish within the function time limit)
# MAX_PAGES_CAP=100
# MAX_DEPTH_CAP=5
MIN_CRAWL_DELAY=0.5
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_JOBS=3
# Hosts allowed to resolve to private IPs (host:port). Needed for the local demo site only.
# PRIVATE_HOST_ALLOWLIST=localhost:8765,127.0.0.1:8765
