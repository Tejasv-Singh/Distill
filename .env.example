# Copy to .env and edit. Every setting is optional; the defaults run locally.

# ---- AI (needed only for AI outputs; file conversions work without it) ----
# anthropic | openai | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# writes the final output
ANTHROPIC_MODEL=claude-sonnet-5-5
# reads long pages chunk by chunk
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini
# any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# Google AI Studio key (https://aistudio.google.com/apikey); set AI_PROVIDER=gemini to use it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=120
# ~6k tokens per chunk
AI_CHUNK_CHARS=24000
# hard budget per output
AI_MAX_TOTAL_CHARS=400000

# ---- Storage ----
# DATABASE_URL=sqlite:///data/app.db                                  # default
# DATABASE_URL=postgresql+psycopg://distill:distill@localhost:5432/distill
# STORAGE_DIR=data/files

# ---- Fetching ----
USER_AGENT=Mozilla/5.0 (compatible; Distill/2.0)
REQUEST_TIMEOUT=20
MAX_PAGE_BYTES=8388608
MAX_REDIRECTS=5
# use headless Chromium for JavaScript-heavy pages
JS_RENDERING=true
TAKE_SCREENSHOTS=true
# use an installed Google Chrome instead of Playwright's Chromium
# BROWSER_CHANNEL=chrome

# ---- Limits & protection ----
MAX_PAGES_CAP=100
MAX_DEPTH_CAP=5
MIN_CRAWL_DELAY=0.5
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_JOBS=3
# Hosts allowed to resolve to private IPs (host:port). Needed for the local demo site only.
# PRIVATE_HOST_ALLOWLIST=localhost:8765,127.0.0.1:8765
